# hack/benchmark/.env.sample — copy to hack/benchmark/<name>.env and fill in,
# or run `make benchmark-init BENCHMARK_ENV=<name>` to be walked through it.
#
# The Makefile -include's the file named by BENCHMARK_ENV near the top, so every
# KEY=value below becomes a make variable available to every benchmark-* target.
# `.env` (unnamed) is also included if present, as a legacy/default path — a
# named BENCHMARK_ENV always wins over it.
#
# Ported from llm-d-workload-variant-autoscaler's benchmark branch, adapted to
# this repo: no split WVA_IMAGE_REPO/TAG (this repo builds one IMG), no forked
# llm-d-benchmark (this repo standups the upstream public repo directly), no
# workload PVC (results land on the local runner host via the llmdbenchmark
# CLI's own workspace).
#
# env_guard.py refuses to run a destructive target (standup/run/teardown/reset/
# controller-restart) without a named env file declaring these. Read-only and
# local-only targets (benchmark-preflight, benchmark-report, benchmark-analyze,
# benchmark-plot-*, benchmark-install) are not gated.

# Cluster this file is for. A run refuses to start if the live kube context is
# not this one -- verified by env_guard.py before any destructive target.
KUBE_CONTEXT=dhl-la-1708/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

# ── Cluster / environment ─────────────────────────────────────────────────────
BENCHMARK_NAMESPACE=dhl-la-1708
# Controller image under test. Defaults to the registry image the Makefile
# already resolves (IMAGE_TAG_BASE/llm-scaler:IMG_TAG) -- set explicitly here so
# the env file is a complete record of what ran, per env_guard's contract.
IMG=ghcr.io/ev-shindin/llm-scaler:main
# Model under test, forwarded to the benchmark CLI as -m (overrides the model a
# scenario names). Qwen3-0.6B by default -- small, fast to load, cheap on a
# shared cluster. Pass a bigger model deliberately, not as this file's default.
BENCHMARK_MODEL_ID=Qwen/Qwen3-0.6B
# Workload profile + harness. Linked: the workload declares which harness it
# expects (test/benchmark/scenarios/<workload>.yaml.in), so env_guard treats
# them as a pair. Not BENCHMARK_SPEC -- that is the llmdbenchmark standup spec
# path (guides/workload-autoscaling), a different, unlinked axis.
BENCHMARK_WORKLOAD=bursty
BENCHMARK_HARNESS=inference-perf
# Prometheus/Thanos endpoint. Leave empty to let deploy/install.sh auto-detect
# the cluster's existing Prometheus (the usual case) -- env_guard only checks
# this when set, it does not require or derive a specific URL.
PROMETHEUS_URL=

# ── Shared-cluster safety ─────────────────────────────────────────────────────
# Keep true on any shared cluster: prometheus-adapter and KEDA both register the
# external.metrics.k8s.io APIService, a cluster-wide singleton, and only one may
# own it. benchmark-standup already only stubs/reuses the ClusterRole rather
# than force-installing -- this just keeps that path selected.
BENCHMARK_SKIP_PROMETHEUS_ADAPTER=true
