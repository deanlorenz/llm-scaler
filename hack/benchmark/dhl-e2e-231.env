# dhl-e2e-231 — benchmark-run-only env for the pokprod shared cluster.
#
# Verification target for the run_only.sh port (see
# docs/plans/benchmark/run-only-metrics-gap.md). This namespace already has
# llm-d + WVA-as-KEDA-external-scaler deployed (EPP, wva-controller-manager)
# with the decode Deployment scaled to 0 and its ScaledObject paused -- no
# standup needed, only benchmark-run-only / benchmark-guard-gated targets.
# No `workload-pvc` exists here (confirmed 2026-08-21) -- benchmark-run-only
# always uses local (-o) output, never PVC mode, for exactly this reason.

# Cluster this file is for. A run refuses to start if the live kube context is
# not this one.
KUBE_CONTEXT=dhl-e2e-231/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

# ── Cluster / environment ─────────────────────────────────────────────────────
BENCHMARK_NAMESPACE=dhl-e2e-231
# Controller image actually running (verified live: `kubectl get deploy
# wva-controller-manager -n dhl-e2e-231 -o jsonpath='{.spec.template.spec.containers[*].image}'`).
IMG=quay.io/deanlorenz/llm-scaler:e2e-test
# Model actually served by optimized-baseline-nvidia-gpu-vllm-decode
# (verified live: its container args name Qwen/Qwen3-0.6B directly) --
# already the small-model default, no override needed.
BENCHMARK_MODEL_ID=Qwen/Qwen3-0.6B
# Minimal smoke workload (test/benchmark/scenarios/quick_smoke.yaml.in): two
# short low-rate stages (~3 min of load), just enough to produce a real trace
# for extraction/rendering -- not a real scenario run.
BENCHMARK_WORKLOAD=quick_smoke
BENCHMARK_HARNESS=inference-perf
# Resolved live via hack/benchmark/resolve_router_endpoint.sh dhl-e2e-231
# (same router-epp|inference-gateway|epp$ detection wait_serving.sh uses).
BENCHMARK_ENDPOINT_URL=http://optimized-baseline-epp.dhl-e2e-231.svc.cluster.local:80
