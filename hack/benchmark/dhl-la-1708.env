# dhl-la-1708 — benchmark env for the pokprod shared cluster.
#
# Records what a run against the already-standing dhl-la-1708 stack actually
# used. This namespace already has llm-d + WVA-as-KEDA-external-scaler
# deployed (gateway, EPP, wva-controller-manager) with a decode Deployment
# scaled to 0 and its ScaledObject paused -- so no standup is needed here,
# only benchmark-run / benchmark-reset-run / benchmark-guard-gated targets.

# Cluster this file is for. A run refuses to start if the live kube context is
# not this one.
KUBE_CONTEXT=dhl-la-1708/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

# ── Cluster / environment ─────────────────────────────────────────────────────
BENCHMARK_NAMESPACE=dhl-la-1708
# Controller image actually running (verified live: `oc get deploy
# wva-controller-manager -o jsonpath='{.spec.template.spec.containers[*].image}'`).
IMG=ghcr.io/ev-shindin/llm-scaler:main
# Model actually served by optimized-baseline-nvidia-gpu-vllm-decode.
#
# Moved from Qwen/Qwen3-32B (TP=2) to the small model on purpose: the 32B
# deployment OOMs on every startup on this cluster --
# docs/guides/install-small-model/README.md documents this exact failure
# (FMA launcher pods hold GPU memory without requesting it through the
# scheduler, so vLLM's gpu_memory_utilization budget is computed against a
# card Kubernetes believes is empty and isn't). Confirmed live, twice,
# identical numbers both times -- not transient. See make benchmark-standup's
# GPU_MEM_UTIL=0.30 for the matching setting on this model.
#
# Do NOT change this without checking what is actually deployed -- the
# harness targets this model by name, and a mismatch fails silently at the
# routing layer.
BENCHMARK_MODEL_ID=Qwen/Qwen3-0.6B
# Minimal smoke workload (test/benchmark/scenarios/quick_smoke.yaml.in): two
# short low-rate stages (~3 min of load), just enough to produce a real trace
# for extraction/rendering -- not a real scenario run.
BENCHMARK_WORKLOAD=quick_smoke
BENCHMARK_HARNESS=inference-perf
# Required for a stack that was NOT deployed via benchmark-standup: the CLI's
# own endpoint auto-detection looks for service/pod names matching its
# standup templates and finds nothing here, then fails fast with "No
# service/gateway IP found ... Is the model deployed?" -- even though the
# model is up and wait_serving.sh already confirmed it (HTTP 200). Confirmed
# live, twice: the run that omitted this failed at step [03] detect_endpoint
# before generating any load.
BENCHMARK_ENDPOINT_URL=http://llm-d-inference-gateway-istio.dhl-la-1708.svc.cluster.local:80
# Leave empty: deploy/install.sh / the cluster's own Prometheus is what WVA
# already reads from (this stack is standing, not being installed by us).
PROMETHEUS_URL=

# ── Shared-cluster safety ─────────────────────────────────────────────────────
BENCHMARK_SKIP_PROMETHEUS_ADAPTER=true
