# dhl-la-1708 — identity guard for bench-* targets on pokprod.
#
# This file contains only identity: which kubeconfig, which context, which
# namespace. Nothing else. All stack config (models, endpoints, secrets, quirks)
# is discovered by bench-init and written to bench-meta.json.
#
# Usage:
#   set -a && source hack/benchmark/dhl-la-1708.env && set +a
#   make bench-init          # discover stack, write bench-meta.json
#   make bench-run           # run against discovered stack
#
# bench-run will refuse to proceed if the live context != BENCH_KUBE_CONTEXT.

BENCH_KUBECONFIG=/home/dean/.kube/la-test
BENCH_KUBE_CONTEXT=dhl-la-1708/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com
BENCH_NAMESPACE=dhl-la-1708

# Default workloads for bench-run-all. Space-separated; first is the bench-run default.
BENCH_WORKLOADS="prefill_heavy symmetrical burst_4k250"
