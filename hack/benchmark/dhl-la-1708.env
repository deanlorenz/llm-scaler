# dhl-la-1708 — bench-run env for the pokprod shared cluster.
#
# Two ScaledObjects, one per variant:
#   optimized-baseline-nvidia-gpu-vllm-decode     (SO: *-wva,    modelID=Qwen/Qwen3-32B trigger)
#   optimized-baseline-nvidia-gpu-vllm-decode-v2  (SO: *-wva-v2, modelID=Qwen/Qwen3-0.6B trigger)
#
# Both decode Deployments actually serve Qwen/Qwen3-0.6B (confirmed from container args).
# The v1 SO carries a stale modelID (32B) in its trigger metadata — not relevant to
# bench-run, which targets the endpoint URL directly, not the SO trigger.
#
# Node note: pokprod-b93r38s1 has a broken GPU (requires reset — NVLink state error).
# Only pods landing on pokprod-b93r38s0 will be Ready. Keep v2 SO paused until
# the node is repaired.
#
# EPP secret: WVA's namePrefix produces wva-epp-metrics-token here, not the
# canonical epp-metrics-token from config/base/rbac/epp-metrics-token-secret.yaml.
#
# Usage — Option A (recommended, same convention as benchmark-run-only):
#   set -a && source hack/benchmark/dhl-la-1708.env && set +a
#   make bench-run
#
# Usage — Option B (single-line convenience):
#   make bench-run BENCH_ENV_FILE=hack/benchmark/dhl-la-1708.env
#
# Unpause ScaledObjects before running (re-pause v2 until pokprod-b93r38s1 is fixed):
#   kubectl annotate scaledobject -n dhl-la-1708 \
#     optimized-baseline-nvidia-gpu-vllm-decode-wva \
#     autoscaling.keda.sh/paused-replicas-
#   kubectl wait --for=condition=Ready pod -l llm-d.ai/role=decode \
#     -n dhl-la-1708 --timeout=300s

# Kube context this env is for.
BENCH_KUBE_CONTEXT=dhl-la-1708/api-pokprod001-ete14-res-ibm-com:6443/DEAN@il.ibm.com

# ── Cluster / environment ─────────────────────────────────────────────────────
BENCH_NAMESPACE=dhl-la-1708

# Model served by both decode Deployments (confirmed from container args).
BENCH_MODEL_ID=Qwen/Qwen3-0.6B

# Default scenario — override with BENCH_WORKLOAD=<name>
BENCH_WORKLOAD=prefill_heavy

# Default harness
BENCH_HARNESS=guidellm

# EPP secret name (WVA namePrefix convention on this cluster).
BENCH_EPP_METRICS_SECRET=wva-epp-metrics-token

# Inference endpoint — EPP service port 80.
# Auto-detection via wait_serving.sh also finds this; set explicitly for speed.
BENCH_ENDPOINT_URL=http://optimized-baseline-epp.dhl-la-1708.svc.cluster.local:80

# WVA metrics service (for scrape_wva_metrics.sh client-side scraper).
WVA_METRICS_SERVICE=wva-controller-manager-metrics-service

# Pod label selector override for collect_metrics.sh / run_only_collect_metrics.sh.
# This cluster does not label decode pods with llm-d.ai/inferenceServing=true;
# use llm-d.ai/role=decode instead (matches both decode deployments).
LLMDBENCH_METRICS_POD_PATTERN=decode
