# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
main
bin/
.vscode/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Kind config file
kind-config.yaml

# Kubernetes manifests
gpu.cluster

# Miscellaneous
.DS_Store
~*

# llm-d and llm-d-infra directories
llm-d/
llm-d-infra/
llm-d-benchmark/
# llmdbenchmark workspace directories (created by benchmark runs)
*-*-*-*-*-*/
biran-*/
llmd/
llmd-infra/

*.tgz
actionlint

# Generated TLS certificates (auto-created by e2e test setup)
hack/tls-certs/

# AI
.claude/worktrees/

# ScaledObject plan written by `make benchmark-deploy-wva`
benchmark-scaledobject-plan.yaml
wva-plan.yaml

# Worktree-local kubeconfig (scoped to one context, never committed --
# credentials, and other worktrees/sessions on this shared machine must not
# be able to perturb which context this one uses)
/.kube/

# benchmark-run-only scratch output (rendered configs + raw run results) --
# hack/benchmark/results/ is for curated, deliberately-committed examples only
hack/benchmark/run-only-scratch/

# Python bytecode from the hack/benchmark scripts
__pycache__/
*.pyc
