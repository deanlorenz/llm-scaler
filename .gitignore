gpu.cluster

# Miscellaneous
.DS_Store
~*

# llm-d and llm-d-infra directories
llm-d/
llm-d-infra/
llm-d-benchmark/
# llmdbenchmark workspace directories (created by benchmark runs), at repo
# root only (BENCHMARK_WORKSPACE defaults to $(CURDIR)). Naming convention is
# <user>-<YYYYMMDD>-<HHMMSS>-<ms>/ -- anchored and shaped with digit classes
# rather than a bare */*/*/*/ glob, which also matched unrelated directories
# elsewhere in the tree (e.g. hack/benchmark/sample-run/quick_smoke-dhl-la-1708/
# has the same hyphen count by coincidence). The old *-*-*-*-*-*/ pattern (5
# hyphens) never matched the real 3-hyphen name either way; found when a real
# run directory, including its 270MB per-request file, showed up untracked.
/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9]*/
biran-*/
/latest
llmd/
llmd-infra/

*.tgz
actionlint

# Generated TLS certificates (auto-created by e2e test setup)
hack/tls-certs/

# AI
.claude/worktrees/

# ScaledObject plan written by `make benchmark-deploy-wva`
benchmark-scaledobject-plan.yaml
wva-plan.yaml

# Worktree-local kubeconfig (scoped to one context, never committed --
# credentials, and other worktrees/sessions on this shared machine must not
# be able to perturb which context this one uses)
/.kube/

# Python bytecode from the hack/benchmark scripts
__pycache__/
*.pyc
